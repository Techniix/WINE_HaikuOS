+//	#pragma mark - custom FS and LDT support
+//
+// Programs that run 32 bit code (compatibility mode) inside a 64 bit team,
+// such as Wine's WoW64, need a 32 bit code segment (USER32_CODE_SELECTOR in
+// the GDT), local descriptor table entries for their own data segments, and
+// an FS register that is not tied to the TLS block. Once a team asks for any
+// of this (THREAD_SET_FS_BASE/THREAD_SET_LDT), its threads' FS selector and
+// FS base are saved and restored on context switches and signals.
+
+
+static_assert(offsetof(struct fpu_state, fs_base) == 496,
+	"fs_base must live in the software area of the FXSAVE layout");
+
+
+static bool
+is_valid_ldt_descriptor(uint64 descriptor)
+{
+	if (descriptor == 0)
+		return true;
+
+	// Only code and data segments (no gates or other system descriptors),
+	// only for user mode, and no 64 bit code segments.
+	if ((descriptor & (1ULL << 44)) == 0)
+		return false;
+	if (((descriptor >> 45) & 3) != 3)
+		return false;
+	if ((descriptor & (1ULL << 53)) != 0)
+		return false;
+	return true;
+}
+
+
+/*!	Returns whether  selector may be loaded into FS for a thread of
+	 team. The caller must hold the team's ldt_lock.
+*/
+static bool
+is_valid_user_fs_selector(Team* team, uint16 selector)
+{
+	if (selector == 0)
+		return true;
+	if ((selector & 3) != 3)
+		return false;
+	if ((selector & 4) == 0)
+		return selector == USER_DATA_SELECTOR;
+
+	uint64* ldt = team->arch_info.ldt;
+	uint32 index = selector >> 3;
+	if (ldt == NULL || index >= X86_LDT_ENTRIES)
+		return false;
+
+	uint64 descriptor = ldt[index];
+	uint32 type = (descriptor >> 40) & 0xf;
+	return (descriptor & (1ULL << 47)) != 0			// present
+		&& (descriptor & (1ULL << 44)) != 0			// code/data
+		&& ((descriptor >> 45) & 3) == 3			// DPL 3
+		&& ((type & 0x8) == 0 || (type & 0x2) != 0);	// data or readable
+}
+
+
+/*!	Saves the FS selector and base of  thread, which must be the thread
+	currently running on this CPU (or just being switched out).
+*/
+void
+x86_64_save_user_fs(Thread* thread)
+{
+	uint16 selector;
+	asm volatile("movw %%fs, %w0" : "=r" (selector));
+	thread->arch_info.user_fs = selector;
+	thread->arch_info.user_fs_base = x86_read_msr(IA32_MSR_FS_BASE);
+}
+
+
+/*!	Loads the FS state of  thread into the current CPU. Must be called
+	with interrupts disabled, after x86_set_tls_context().
+*/
+void
+x86_64_restore_user_fs(Thread* thread)
+{
+	Team* team = thread->team;
+	int cpu = smp_get_current_cpu();
+
+	if (!team->arch_info.custom_fs) {
+		// Make sure no selector or LDT of another team lingers around.
+		uint16 selector;
+		asm volatile("movw %%fs, %w0" : "=r" (selector));
+		x86_64_load_ldt(cpu, NULL, 0);
+		if (selector != 0) {
+			asm volatile("movw %w0, %%fs" : : "r" (0));
+			x86_write_msr(IA32_MSR_FS_BASE, thread->user_local_storage);
+		}
+		return;
+	}
+
+	uint16 selector = thread->arch_info.user_fs;
+
+	acquire_spinlock(&team->arch_info.ldt_lock);
+	x86_64_load_ldt(cpu, team->arch_info.ldt, X86_LDT_ENTRIES);
+	if (!is_valid_user_fs_selector(team, selector))
+		selector = 0;
+	// Loading the selector also loads the base from the descriptor, so the
+	// base has to be written afterwards.
+	asm volatile("movw %w0, %%fs" : : "r" (selector));
+	release_spinlock(&team->arch_info.ldt_lock);
+
+	x86_write_msr(IA32_MSR_FS_BASE, thread->arch_info.user_fs_base);
+}
+
+
+static status_t
+set_user_fs_base(Thread* thread, uint64 base)
+{
+	if (!IS_USER_ADDRESS(base))
+		return B_BAD_VALUE;
+
+	thread->team->arch_info.custom_fs = true;
+
+	InterruptsLocker locker;
+	thread->arch_info.user_fs_base = base;
+	x86_write_msr(IA32_MSR_FS_BASE, base);
+	return B_OK;
+}
+
+
+static status_t
+set_ldt_entries(Thread* thread, const x86_ldt_args& args)
+{
+	if (args.start >= X86_LDT_ENTRIES
+		|| args.count > X86_LDT_ENTRIES - args.start)
+		return B_BAD_VALUE;
+	if (args.count == 0)
+		return B_OK;
+	if (!IS_USER_ADDRESS(args.descriptors))
+		return B_BAD_ADDRESS;
+
+	size_t size = args.count * sizeof(uint64);
+	uint64* descriptors = (uint64*)malloc(size);
+	if (descriptors == NULL)
+		return B_NO_MEMORY;
+	if (user_memcpy(descriptors, args.descriptors, size) != B_OK) {
+		free(descriptors);
+		return B_BAD_ADDRESS;
+	}
+	for (uint32 i = 0; i < args.count; i++) {
+		if (!is_valid_ldt_descriptor(descriptors[i])) {
+			free(descriptors);
+			return B_NOT_ALLOWED;
+		}
+	}
+
+	Team* team = thread->team;
+	uint64* newLDT = NULL;
+	if (team->arch_info.ldt == NULL) {
+		newLDT = (uint64*)malloc(X86_LDT_ENTRIES * sizeof(uint64));
+		if (newLDT == NULL) {
+			free(descriptors);
+			return B_NO_MEMORY;
+		}
+		memset(newLDT, 0, X86_LDT_ENTRIES * sizeof(uint64));
+	}
+
+	InterruptsSpinLocker locker(team->arch_info.ldt_lock);
+	if (team->arch_info.ldt == NULL) {
+		team->arch_info.ldt = newLDT;
+		newLDT = NULL;
+	}
+	memcpy(team->arch_info.ldt + args.start, descriptors, size);
+	team->arch_info.custom_fs = true;
+	x86_64_load_ldt(smp_get_current_cpu(), team->arch_info.ldt,
+		X86_LDT_ENTRIES);
+	locker.Unlock();
+
+	free(newLDT);
+	free(descriptors);
+	return B_OK;
+}
+
+
 static addr_t
 arch_randomize_stack_pointer(addr_t value)
 {
@@ -159,6 +339,34 @@ arch_thread_control(const char* subsystem, uint32 function, void* buffer,
 			x86_write_msr(IA32_MSR_KERNEL_GS_BASE, base);
 			return B_OK;
 		}
+
+		case THREAD_SET_FS_BASE:
+		{
+			uint64 base;
+			if (bufferSize != sizeof(base))
+				return B_BAD_VALUE;
+
+			if (!IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&base, buffer, sizeof(base)) < B_OK) {
+				return B_BAD_ADDRESS;
+			}
+
+			return set_user_fs_base(thread_get_current_thread(), base);
+		}
+
+		case THREAD_SET_LDT:
+		{
+			x86_ldt_args args;
+			if (bufferSize != sizeof(args))
+				return B_BAD_VALUE;
+
+			if (!IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&args, buffer, sizeof(args)) < B_OK) {
+				return B_BAD_ADDRESS;
+			}
+
+			return set_ldt_entries(thread_get_current_thread(), args);
+		}
 	}
 	return B_BAD_HANDLER;
 }
@@ -390,6 +598,13 @@ arch_setup_signal_frame(Thread* thread, struct sigaction* action,
 	signalFrameData->context.uc_mcontext.fpu.fp_fxsave.ss = frame->ss;
 	signalFrameData->context.uc_mcontext.fpu.fp_fxsave.trap_number = frame->vector;
 
+	uint16 fsSelector;
+	asm volatile("movw %%fs, %w0" : "=r" (fsSelector));
+	signalFrameData->context.uc_mcontext.fpu.fp_fxsave.fs = fsSelector;
+	signalFrameData->context.uc_mcontext.fpu.fp_fxsave.fs_base
+		= thread->team->arch_info.custom_fs
+			? x86_read_msr(IA32_MSR_FS_BASE) : thread->user_local_storage;
+
 	// Fill in signalFrameData->context.uc_stack.
 	signal_get_user_stack(frame->user_sp, &signalFrameData->context.uc_stack);
 
@@ -427,6 +642,16 @@ arch_setup_signal_frame(Thread* thread, struct sigaction* action,
 	frame->di = (addr_t)userSignalFrameData;
 	frame->flags &= ~(uint64)(X86_EFLAGS_TRAP | X86_EFLAGS_DIRECTION);
 
+	// The handler wrapper is 64 bit code using the TLS, even if the thread
+	// was running 32 bit code with a different FS.
+	frame->cs = USER_CODE_SELECTOR;
+	frame->ss = USER_DATA_SELECTOR;
+	if (thread->team->arch_info.custom_fs) {
+		InterruptsLocker locker;
+		thread->arch_info.user_fs_base = thread->user_local_storage;
+		x86_write_msr(IA32_MSR_FS_BASE, thread->user_local_storage);
+	}
+
 	return B_OK;
 }
 
@@ -461,11 +686,27 @@ arch_restore_signal_frame(struct signal_frame_data* signalFrameData)
 	// handler for information purposes only, and are not used after the signal handling is
 	// complete.
 
-	frame->cs = signalFrameData->context.uc_mcontext.fpu.fp_fxsave.cs;
-	frame->ss = signalFrameData->context.uc_mcontext.fpu.fp_fxsave.ss;
+	// Only allow returning to user mode code segments: the 64 bit one, or the
+	// 32 bit one for compatibility mode code.
+	uint16 cs = signalFrameData->context.uc_mcontext.fpu.fp_fxsave.cs;
+	if (cs != USER_CODE_SELECTOR && cs != USER32_CODE_SELECTOR)
+		cs = USER_CODE_SELECTOR;
+	frame->cs = cs;
+	frame->ss = USER_DATA_SELECTOR;
 
 	Thread* thread = thread_get_current_thread();
 
+	if (thread->team->arch_info.custom_fs) {
+		uint64 fsBase = signalFrameData->context.uc_mcontext.fpu.fp_fxsave.fs_base;
+		if (!IS_USER_ADDRESS(fsBase))
+			fsBase = thread->user_local_storage;
+
+		InterruptsLocker locker;
+		thread->arch_info.user_fs = signalFrameData->context.uc_mcontext.fpu.fp_fxsave.fs;
+		thread->arch_info.user_fs_base = fsBase;
+		x86_64_restore_user_fs(thread);
+	}
+
 	memcpy(thread->arch_info.user_fpu_state,
 		(void*)&signalFrameData->context.uc_mcontext.fpu, min_c(gFPUSaveLength, sizeof(savefpu)));
