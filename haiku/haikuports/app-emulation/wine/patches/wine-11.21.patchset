From 9d0bad302c72ce6137422d888d6aa76dc4b02c02 Mon Sep 17 00:00:00 2001
From: Ken Mays <kmays2000@gmail.com>
Date: Sat, 25 Apr 2026 13:40:26 +0200
Subject: [PATCH 4/9] Opensound support

---
 configure.ac               | 27 +++++++++++++++++++--------
 dlls/wineoss.drv/oss.c     |  4 ++++
 dlls/wineoss.drv/ossmidi.c |  4 ++++
 3 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/configure.ac b/configure.ac
index acee17b..a90ae73 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1791,14 +1791,25 @@ then
     then
         . /etc/oss.conf
     fi
-    ac_oss_incl="-I${OSSLIBDIR:-/usr/lib/oss}/include"
-    CPPFLAGS="$CPPFLAGS $ac_oss_incl"
-    AC_CHECK_HEADER([sys/soundcard.h],
-        [AC_CHECK_MEMBER([oss_sysinfo.numaudioengines],
-            [AC_SUBST(OSS4_CFLAGS,"$ac_oss_incl")
-             AC_CHECK_LIB(ossaudio,_oss_ioctl,
-                 [AC_SUBST(OSS4_LIBS,"-lossaudio")])],,
-            [#include <sys/soundcard.h>])])
+    case $host_os in
+      haiku*)
+        dnl Haiku's opensound package ships the header as <audio/soundcard.h>
+        ac_oss_incl="-I${OSSLIBDIR:-/system/develop/headers}/private"
+        CPPFLAGS="$CPPFLAGS $ac_oss_incl"
+        AC_CHECK_HEADER([audio/soundcard.h],
+            [AC_CHECK_MEMBER([oss_sysinfo.numaudioengines],
+                [AC_SUBST(OSS4_CFLAGS,"$ac_oss_incl")],,
+                [#include <audio/soundcard.h>])]) ;;
+      *)
+        ac_oss_incl="-I${OSSLIBDIR:-/usr/lib/oss}/include"
+        CPPFLAGS="$CPPFLAGS $ac_oss_incl"
+        AC_CHECK_HEADER([sys/soundcard.h],
+            [AC_CHECK_MEMBER([oss_sysinfo.numaudioengines],
+                [AC_SUBST(OSS4_CFLAGS,"$ac_oss_incl")
+                 AC_CHECK_LIB(ossaudio,_oss_ioctl,
+                     [AC_SUBST(OSS4_LIBS,"-lossaudio")])],,
+                [#include <sys/soundcard.h>])]) ;;
+    esac
     CPPFLAGS="$ac_save_CPPFLAGS"
 fi
 WINE_NOTICE_WITH(oss,[test "x$ac_cv_member_oss_sysinfo_numaudioengines" != xyes],
diff --git a/dlls/wineoss.drv/oss.c b/dlls/wineoss.drv/oss.c
index 6682a0c..e8a55ef 100644
--- a/dlls/wineoss.drv/oss.c
+++ b/dlls/wineoss.drv/oss.c
@@ -30,7 +30,11 @@
 #include <fcntl.h>
 #include <unistd.h>
 #include <errno.h>
+#ifdef __HAIKU__
+#include <audio/soundcard.h>
+#else
 #include <sys/soundcard.h>
+#endif
 #include <pthread.h>
 
 #include "ntstatus.h"
diff --git a/dlls/wineoss.drv/ossmidi.c b/dlls/wineoss.drv/ossmidi.c
