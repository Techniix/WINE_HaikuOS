+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_HAIKUDRV_UNIXLIB_H
+#define __WINE_HAIKUDRV_UNIXLIB_H
+
+#include <stdarg.h>
