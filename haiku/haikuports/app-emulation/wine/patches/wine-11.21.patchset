diff --git a/dlls/winehaiku.drv/Makefile.in b/dlls/winehaiku.drv/Makefile.in
new file mode 100644
index 0000000..e8aeea2
--- /dev/null
+++ b/dlls/winehaiku.drv/Makefile.in
@@ -0,0 +1,14 @@
+MODULE    = winehaiku.drv
+UNIXLIB   = winehaiku.so
+UNIX_LIBS = -lwin32u -lbe -lgame -lstdc++ $(PTHREAD_LIBS)
+IMPORTS   = user32 win32u
+
+VER_FILEDESCRIPTION_STR = "Wine Haiku driver"
+
+SOURCES = \
+	display.c \
+	dllmain.c \
+	haiku_be.cpp \
+	haikudrv_main.c \
+	keyboard.c \
+	window.c
diff --git a/dlls/winehaiku.drv/display.c b/dlls/winehaiku.drv/display.c
new file mode 100644
index 0000000..3e6ce0d
--- /dev/null
+++ b/dlls/winehaiku.drv/display.c
@@ -0,0 +1,66 @@
+/*
+ * Haiku driver display devices
+ *
+ * Copyright 2026 Techniix
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "haikudrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(haikudrv);
+
+/***********************************************************************
+ *           HAIKU_UpdateDisplayDevices
+ *
+ * Reports the main screen as the only monitor, with its current mode.
+ * FIXME: multiple screens, mode changes.
+ */
+UINT HAIKU_UpdateDisplayDevices( const struct gdi_device_manager *device_manager, void *param )
+{
+    struct pci_id pci_id = {0};
+    struct gdi_monitor monitor = {0};
+    DEVMODEW mode = {.dmSize = sizeof(mode)};
+    int width, height, bpp, refresh;
+
+    haiku_get_screen_info( &width, &height, &bpp, &refresh );
+    TRACE( "screen %dx%d %d bpp %d Hz\n", width, height, bpp, refresh );
+
+    device_manager->add_gpu( "Haiku", &pci_id, NULL, param );
+    device_manager->add_source( "Default", DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE,
+                                NtUserGetSystemDpiForProcess( NULL ), param );
+
+    SetRect( &monitor.rc_monitor, 0, 0, width, height );
+    monitor.rc_work = monitor.rc_monitor;  /* FIXME: exclude the Deskbar */
+    device_manager->add_monitor( &monitor, param );
+
+    mode.dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT |
+                    DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY | DM_POSITION;
+    mode.dmDisplayOrientation = DMDO_DEFAULT;
+    mode.dmBitsPerPel = bpp;
+    mode.dmPelsWidth = width;
+    mode.dmPelsHeight = height;
+    mode.dmDisplayFrequency = refresh;
+    device_manager->add_modes( &mode, 1, &mode, param );
+
+    return STATUS_SUCCESS;
+}
diff --git a/dlls/winehaiku.drv/dllmain.c b/dlls/winehaiku.drv/dllmain.c
new file mode 100644
index 0000000..3aa8be5
--- /dev/null
+++ b/dlls/winehaiku.drv/dllmain.c
@@ -0,0 +1,52 @@
+/*
+ * Haiku driver PE side
+ *
+ * Copyright 2026 Techniix
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(haikudrv);
+
+/* Haiku's window threads can't call into Wine, so they hand their events to
+ * this thread, which feeds them to win32u. */
+static DWORD WINAPI haiku_events_thread( void *arg )
+{
+    WINE_UNIX_CALL( haikudrv_unix_func_read_events, NULL );
+    ERR( "Haiku event loop failed, terminating process\n" );
+    TerminateProcess( GetCurrentProcess(), 1 );
+    return 0;
+}
+
+BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
+{
+    DWORD tid;
+
+    if (reason != DLL_PROCESS_ATTACH) return TRUE;
+
+    DisableThreadLibraryCalls( instance );
+    if (__wine_init_unix_call()) return FALSE;
+    if (WINE_UNIX_CALL( haikudrv_unix_func_init, NULL )) return FALSE;
+
+    CloseHandle( CreateThread( NULL, 0, haiku_events_thread, NULL, 0, &tid ));
+    return TRUE;
+}
diff --git a/dlls/winehaiku.drv/haiku_be.cpp b/dlls/winehaiku.drv/haiku_be.cpp
new file mode 100644
index 0000000..2c89897
--- /dev/null
+++ b/dlls/winehaiku.drv/haiku_be.cpp
@@ -0,0 +1,382 @@
+/*
+ * Haiku driver: glue code for the Haiku (Be API) application, window and
+ * view classes
+ *
+ * Copyright 2026 Techniix
+ *
+ * Based on the Wine 7.1 Haiku driver by X512.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+/* Only Haiku headers here; everything that touches Wine is in the C files.
+ * Nothing in this file may call into Wine, since it mostly runs on threads
+ * created by the Haiku application kit. */
+
+#include <Application.h>
+#include <Bitmap.h>
+#include <InterfaceDefs.h>
+#include <Message.h>
+#include <OS.h>
+#include <Screen.h>
+#include <View.h>
+#include <Window.h>
+#include <WindowScreen.h>
+
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+#include <new>
+
+#include "haiku_be.h"
+
+static int event_fd = -1;
+
+static void post_event( const struct haiku_event &event )
+{
+    ssize_t ret;
+
+    /* the pipe is non-blocking: if Wine can't keep up we rather drop events
+     * than block a window thread */
+    do ret = write( event_fd, &event, sizeof(event) );
+    while (ret < 0 && errno == EINTR);
+}
+
+static struct haiku_event make_event( int32_t type, uint64_t hwnd )
+{
+    struct haiku_event event;
+
+    memset( &event, 0, sizeof(event) );
+    event.type = type;
+    event.hwnd = hwnd;
+    return event;
+}
+
+
+class WineView : public BView
+{
+public:
+    WineView( BRect frame, uint64_t hwnd )
+        : BView( frame, "wine", B_FOLLOW_ALL, B_WILL_DRAW ),
+          fHwnd( hwnd ), fBitmap( NULL ), fOrigin( 0, 0 ), fButtons( 0 )
+    {
+        /* we draw every pixel ourselves */
+        SetViewColor( B_TRANSPARENT_COLOR );
+    }
+
+    ~WineView()
+    {
+        delete fBitmap;
+    }
+
+    void Draw( BRect update )
+    {
+        if (!fBitmap) return;
+        BRect src = update.OffsetByCopy( -fOrigin.x, -fOrigin.y ) & fBitmap->Bounds();
+        if (src.IsValid()) DrawBitmap( fBitmap, src, src.OffsetByCopy( fOrigin ) );
+    }
+
+    /* called with the window locked */
+    void UpdateBits( const void *bits, int stride, int width, int height, BPoint origin, BRect dirty )
+    {
+        if (origin != fOrigin)
+        {
+            fOrigin = origin;
+            Invalidate();
+        }
+        if (!fBitmap || fBitmap->Bounds().IntegerWidth() + 1 != width ||
+            fBitmap->Bounds().IntegerHeight() + 1 != height)
+        {
+            delete fBitmap;
+            fBitmap = new (std::nothrow) BBitmap( BRect( 0, 0, width - 1, height - 1 ), B_RGB32 );
+            if (fBitmap && fBitmap->InitCheck() != B_OK)
+            {
+                delete fBitmap;
+                fBitmap = NULL;
+            }
+            if (!fBitmap) return;
+            dirty = fBitmap->Bounds();
+        }
+
+        int top = (int)dirty.top, bottom = (int)dirty.bottom;
+        int left = (int)dirty.left, right = (int)dirty.right;
+        int32 dst_stride = fBitmap->BytesPerRow();
+        const uint8 *src = (const uint8 *)bits;
+        uint8 *dst = (uint8 *)fBitmap->Bits();
+
+        /* both are 32-bit BGRX, top-down */
+        for (int y = top; y <= bottom; y++)
+            memcpy( dst + y * dst_stride + left * 4, src + y * stride + left * 4, (right - left + 1) * 4 );
+
+        Invalidate( dirty.OffsetByCopy( fOrigin ) );
+    }
+
+    void MouseDown( BPoint where )
+    {
+        /* keep getting events while a button is held, also outside the window */
+        SetMouseEventMask( B_POINTER_EVENTS, B_NO_POINTER_HISTORY );
+        SendMouse( where );
+    }
+
+    void MouseUp( BPoint where )
+    {
+        SendMouse( where );
+    }
+
+    void MouseMoved( BPoint where, uint32 transit, const BMessage *drag )
+    {
+        SendMouse( where );
+    }
+
+    void MessageReceived( BMessage *msg )
+    {
+        if (msg->what == B_MOUSE_WHEEL_CHANGED)
+        {
+            struct haiku_event event = make_event( HAIKU_EVENT_WHEEL, fHwnd );
+            if (msg->FindFloat( "be:wheel_delta_x", &event.wheel_x ) != B_OK) event.wheel_x = 0;
+            if (msg->FindFloat( "be:wheel_delta_y", &event.wheel_y ) != B_OK) event.wheel_y = 0;
+            post_event( event );
+            return;
+        }
+        BView::MessageReceived( msg );
+    }
+
+private:
+    void SendMouse( BPoint where )
+    {
+        struct haiku_event event = make_event( HAIKU_EVENT_MOUSE, fHwnd );
+        BMessage *msg = Window()->CurrentMessage();
+        int32 buttons = 0;
+
+        if (msg && msg->FindInt32( "buttons", &buttons ) != B_OK) buttons = 0;
+        else if (!msg) buttons = fButtons;
+
+        ConvertToScreen( &where );
+        event.x = (int32_t)where.x;
+        event.y = (int32_t)where.y;
+        event.buttons = buttons;
+        event.old_buttons = fButtons;
+        fButtons = buttons;
+        post_event( event );
+    }
+
+    uint64_t fHwnd;
+    BBitmap *fBitmap;
+    BPoint   fOrigin;
+    uint32   fButtons;
+};
+
+
+class WineWindow : public BWindow
+{
+public:
+    WineWindow( uint64_t hwnd, bool popup )
+        /* Wine draws the non-client area itself, so no Haiku decorations */
+        : BWindow( BRect( 0, 0, 0, 0 ), "Wine", B_NO_BORDER_WINDOW_LOOK,
+                   popup ? B_FLOATING_APP_WINDOW_FEEL : B_NORMAL_WINDOW_FEEL,
+                   B_ASYNCHRONOUS_CONTROLS | B_NOT_RESIZABLE | B_NOT_ZOOMABLE |
+                   (popup ? B_AVOID_FOCUS : 0) ),
+          fHwnd( hwnd )
+    {
+        fView = new WineView( Bounds(), hwnd );
+        AddChild( fView );
+        fView->MakeFocus();
+    }
+
+    bool QuitRequested()
+    {
+        /* let Wine decide, it will destroy the window if needed */
+        post_event( make_event( HAIKU_EVENT_CLOSE, fHwnd ) );
+        return false;
+    }
+
+    void WindowActivated( bool active )
+    {
+        struct haiku_event event = make_event( HAIKU_EVENT_ACTIVATE, fHwnd );
+        event.active = active;
+        post_event( event );
+    }
+
+    void ScreenChanged( BRect frame, color_space mode )
+    {
+        post_event( make_event( HAIKU_EVENT_SCREEN_CHANGED, fHwnd ) );
+    }
+
+    void DispatchMessage( BMessage *msg, BHandler *target )
+    {
+        /* Pass all keys to Wine, bypassing the window's keyboard shortcuts
+         * (Alt+Q/W/X/C/V/A with the default keymap). */
+        switch (msg->what)
+        {
+        case B_KEY_DOWN:
+        case B_UNMAPPED_KEY_DOWN:
+        case B_KEY_UP:
+        case B_UNMAPPED_KEY_UP:
+        {
+            int32 key;
+            bool down = msg->what == B_KEY_DOWN || msg->what == B_UNMAPPED_KEY_DOWN;
+            struct haiku_event event = make_event( down ? HAIKU_EVENT_KEY_DOWN : HAIKU_EVENT_KEY_UP, fHwnd );
+
+            if (msg->FindInt32( "key", &key ) == B_OK)
+            {
+                event.key = key;
+                post_event( event );
+            }
+            return;
+        }
+        }
+        BWindow::DispatchMessage( msg, target );
+    }
+
+    WineView *fView;
+
+private:
+    uint64_t fHwnd;
+};
+
+
+struct haiku_window : public WineWindow
+{
+    haiku_window( uint64_t hwnd, bool popup ) : WineWindow( hwnd, popup ) {}
+};
+
+
+class WineApplication : public BApplication
+{
+public:
+    WineApplication() : BApplication( "application/x-vnd.Wine" ) {}
+};
+
+static sem_id app_ready = -1;
+
+static int32 app_thread( void *arg )
+{
+    new WineApplication();
+    release_sem( app_ready );
+    be_app->Run();
+    return 0;
+}
+
+extern "C" int haiku_be_init( int fd )
+{
+    thread_id thread;
+
+    event_fd = fd;
+    if (be_app) return 0;  /* already initialized */
+
+    if ((app_ready = create_sem( 0, "wine app ready" )) < B_OK) return -1;
+    thread = spawn_thread( app_thread, "wine application", B_NORMAL_PRIORITY, NULL );
+    if (thread < B_OK || resume_thread( thread ) != B_OK) return -1;
+    acquire_sem( app_ready );
+    delete_sem( app_ready );
+    return 0;
+}
+
+extern "C" haiku_window *haiku_window_create( uint64_t hwnd, int popup )
+{
+    haiku_window *win = new (std::nothrow) haiku_window( hwnd, popup != 0 );
+
+    if (!win) return NULL;
+    win->Run();  /* starts the window thread; the window stays hidden */
+    return win;
+}
+
+extern "C" void haiku_window_destroy( haiku_window *win )
+{
+    if (!win || !win->Lock()) return;
+    win->Quit();  /* deletes the window */
+}
+
+extern "C" void haiku_window_set_frame( haiku_window *win, int x, int y, int width, int height )
+{
+    if (width < 1) width = 1;
+    if (height < 1) height = 1;
+    if (!win->Lock()) return;
+    win->MoveTo( x, y );
+    win->ResizeTo( width - 1, height - 1 );
+    win->Unlock();
+}
+
+extern "C" void haiku_window_show( haiku_window *win, int show, int activate )
+{
+    if (!win->Lock()) return;
+    if (show)
+    {
+        while (win->IsHidden()) win->Show();
+        if (activate) win->Activate( true );
+    }
+    else
+    {
+        while (!win->IsHidden()) win->Hide();
+    }
+    win->Unlock();
+}
+
+extern "C" void haiku_window_set_title( haiku_window *win, const char *utf8 )
+{
+    if (!win->Lock()) return;
+    win->SetTitle( utf8 );
+    win->Unlock();
+}
+
+extern "C" void haiku_window_update( haiku_window *win, const void *bits, int stride, int width, int height,
+                                     int origin_x, int origin_y, int left, int top, int right, int bottom )
+{
+    if (left < 0) left = 0;
+    if (top < 0) top = 0;
+    if (right > width) right = width;
+    if (bottom > height) bottom = height;
+    if (left >= right || top >= bottom) return;
+
+    if (!win->Lock()) return;
+    win->fView->UpdateBits( bits, stride, width, height, BPoint( origin_x, origin_y ),
+                            BRect( left, top, right - 1, bottom - 1 ) );
+    win->Unlock();
+}
+
+extern "C" void haiku_get_screen_info( int *width, int *height, int *bpp, int *refresh )
+{
+    BScreen screen( B_MAIN_SCREEN_ID );
+    display_mode mode;
+    BRect frame = screen.Frame();
+
+    *width = frame.IntegerWidth() + 1;
+    *height = frame.IntegerHeight() + 1;
+    *bpp = 32;
+    *refresh = 60;
+    if (screen.GetMode( &mode ) == B_OK && mode.timing.h_total && mode.timing.v_total)
+        *refresh = (int)((mode.timing.pixel_clock * 1000.0) /
+                         ((double)mode.timing.h_total * mode.timing.v_total) + 0.5);
+}
+
+extern "C" int haiku_get_mouse( int *x, int *y )
+{
+    BPoint where;
+    uint32 buttons;
+
+    if (get_mouse( &where, &buttons ) != B_OK) return 0;
+    *x = (int)where.x;
+    *y = (int)where.y;
+    return 1;
+}
+
+extern "C" void haiku_set_mouse( int x, int y )
+{
+    set_mouse_position( x, y );
+}
diff --git a/dlls/winehaiku.drv/haiku_be.h b/dlls/winehaiku.drv/haiku_be.h
new file mode 100644
index 0000000..ec3a3c8
--- /dev/null
+++ b/dlls/winehaiku.drv/haiku_be.h
@@ -0,0 +1,84 @@
+/*
+ * Haiku driver: interface to the Haiku (Be API) glue code
+ *
+ * Copyright 2026 Techniix
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_HAIKU_BE_H
+#define __WINE_HAIKU_BE_H
+
+/* This header is shared between the C driver code (which uses Wine headers)
+ * and haiku_be.cpp (which uses Haiku headers), so it only uses plain types. */
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum haiku_event_type
+{
+    HAIKU_EVENT_MOUSE,          /* x, y (screen), buttons, old_buttons */
+    HAIKU_EVENT_WHEEL,          /* wheel_x, wheel_y */
+    HAIKU_EVENT_KEY_DOWN,       /* key */
+    HAIKU_EVENT_KEY_UP,         /* key */
+    HAIKU_EVENT_CLOSE,          /* close requested by the user */
+    HAIKU_EVENT_ACTIVATE,       /* active */
+    HAIKU_EVENT_SCREEN_CHANGED, /* screen mode or layout changed */
+};
+
+/* Haiku window threads are not Wine threads, so they never call into Wine;
+ * they write these to a pipe that a Wine thread reads (see haikudrv_main.c).
+ * Keep it small: pipe writes of up to PIPE_BUF bytes are atomic. */
+struct haiku_event
+{
+    int32_t   type;
+    int32_t   x, y;
+    uint32_t  buttons;
+    uint32_t  old_buttons;
+    int32_t   key;
+    int32_t   active;
+    float     wheel_x, wheel_y;
+    uint64_t  hwnd;
+};
+
+/* mouse buttons, as reported by Haiku */
+#define HAIKU_BUTTON_PRIMARY    0x1
+#define HAIKU_BUTTON_SECONDARY  0x2
+#define HAIKU_BUTTON_TERTIARY   0x4
+
+typedef struct haiku_window haiku_window;  /* opaque, a WineWindow (BWindow) */
+
+int  haiku_be_init( int event_fd );
+haiku_window *haiku_window_create( uint64_t hwnd, int popup );
+void haiku_window_destroy( haiku_window *win );
+void haiku_window_set_frame( haiku_window *win, int x, int y, int width, int height );
+void haiku_window_show( haiku_window *win, int show, int activate );
+void haiku_window_set_title( haiku_window *win, const char *utf8 );
+/* bits: 32-bit top-down surface of width x height, placed at (origin_x, origin_y)
+ * in window coordinates; left/top/right/bottom: dirty rect in surface coordinates */
+void haiku_window_update( haiku_window *win, const void *bits, int stride, int width, int height,
+                          int origin_x, int origin_y, int left, int top, int right, int bottom );
+void haiku_get_screen_info( int *width, int *height, int *bpp, int *refresh );
+int  haiku_get_mouse( int *x, int *y );
+void haiku_set_mouse( int x, int y );
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __WINE_HAIKU_BE_H */
diff --git a/dlls/winehaiku.drv/haikudrv.h b/dlls/winehaiku.drv/haikudrv.h
new file mode 100644
index 0000000..498ddd3
--- /dev/null
+++ b/dlls/winehaiku.drv/haikudrv.h
@@ -0,0 +1,78 @@
+/*
+ * Haiku driver definitions
+ *
+ * Copyright 2026 Techniix
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_HAIKUDRV_H
+#define __WINE_HAIKUDRV_H
+
+#ifndef __WINE_CONFIG_H
+# error You must include config.h to use this header
+#endif
+
+#include <stdarg.h>
+#include <pthread.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "ntgdi.h"
+#include "ntuser.h"
+#include "wine/gdi_driver.h"
+#include "wine/rbtree.h"
+
+#include "unixlib.h"
+#include "haiku_be.h"
+
+/* messages posted from the event thread to window threads */
+enum haikudrv_window_message
+{
+    WM_HAIKU_SET_FOREGROUND = WM_WINE_FIRST_DRIVER_MSG,
+    WM_HAIKU_DISPLAY_CHANGED,
+};
+
+/* per-window driver data, for top-level windows only */
+struct haiku_win_data
+{
+    struct rb_entry     entry;
+    HWND                hwnd;
+    haiku_window       *window;   /* Haiku window, created when the window gets a surface */
+    struct window_rects rects;
+};
+
+extern struct haiku_win_data *haiku_win_data_get( HWND hwnd );
+extern void haiku_win_data_release( struct haiku_win_data *data );
+
+extern void haiku_handle_event( const struct haiku_event *event );
+extern UINT haiku_key_to_scan( int key );
+
+extern BOOL HAIKU_CreateWindowSurface( HWND hwnd, BOOL layered, const RECT *surface_rect,
+                                       struct window_surface **surface );
+extern LRESULT HAIKU_DesktopWindowProc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp );
+extern void HAIKU_DestroyWindow( HWND hwnd );
+extern BOOL HAIKU_GetCursorPos( POINT *pos );
+extern BOOL HAIKU_SetCursorPos( INT x, INT y );
+extern void HAIKU_SetWindowText( HWND hwnd, LPCWSTR text );
+extern UINT HAIKU_UpdateDisplayDevices( const struct gdi_device_manager *device_manager, void *param );
+extern LRESULT HAIKU_WindowMessage( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp );
+extern BOOL HAIKU_WindowPosChanging( HWND hwnd, UINT swp_flags, BOOL shaped, const struct window_rects *rects );
+extern void HAIKU_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
+                                    const struct window_rects *new_rects, struct window_surface *surface );
+
+#endif /* __WINE_HAIKUDRV_H */
diff --git a/dlls/winehaiku.drv/haikudrv_main.c b/dlls/winehaiku.drv/haikudrv_main.c
new file mode 100644
index 0000000..09179ac
--- /dev/null
+++ b/dlls/winehaiku.drv/haikudrv_main.c
@@ -0,0 +1,188 @@
+/*
+ * Haiku driver initialization and event handling
+ *
+ * Copyright 2026 Techniix
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "haikudrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(haikudrv);
+
+static int event_pipe[2] = { -1, -1 };
+
+static void send_mouse_buttons( HWND hwnd, const struct haiku_event *event )
+{
+    static const struct { UINT button; DWORD down, up; } buttons[] =
+    {
+        { HAIKU_BUTTON_PRIMARY,   MOUSEEVENTF_LEFTDOWN,   MOUSEEVENTF_LEFTUP },
+        { HAIKU_BUTTON_SECONDARY, MOUSEEVENTF_RIGHTDOWN,  MOUSEEVENTF_RIGHTUP },
+        { HAIKU_BUTTON_TERTIARY,  MOUSEEVENTF_MIDDLEDOWN, MOUSEEVENTF_MIDDLEUP },
+    };
+    INPUT input = {0};
+    UINT changed = event->buttons ^ event->old_buttons, i;
+
+    input.type = INPUT_MOUSE;
+    input.mi.dx = event->x;
+    input.mi.dy = event->y;
+    input.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE;
+    for (i = 0; i < ARRAY_SIZE(buttons); i++)
+    {
+        if (!(changed & buttons[i].button)) continue;
+        input.mi.dwFlags |= (event->buttons & buttons[i].button) ? buttons[i].down : buttons[i].up;
+    }
+    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+}
+
+static void send_wheel( HWND hwnd, float delta, DWORD flags )
+{
+    INPUT input = {0};
+
+    if (!delta) return;
+    input.type = INPUT_MOUSE;
+    /* Haiku reports positive values for scrolling down/right */
+    input.mi.mouseData = (flags == MOUSEEVENTF_WHEEL ? -delta : delta) * WHEEL_DELTA;
+    input.mi.dwFlags = flags;
+    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+}
+
+static void send_key( HWND hwnd, int key, BOOL down )
+{
+    INPUT input = {0};
+    UINT scan = haiku_key_to_scan( key );
+
+    if (!(scan & 0xff)) return;
+    input.type = INPUT_KEYBOARD;
+    input.ki.wScan = (scan & 0x300) ? scan + 0xdf00 : scan;
+    input.ki.dwFlags = KEYEVENTF_SCANCODE;
+    if (scan & ~0xff) input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+    if (!down) input.ki.dwFlags |= KEYEVENTF_KEYUP;
+    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+}
+
+void haiku_handle_event( const struct haiku_event *event )
+{
+    HWND hwnd = (HWND)(UINT_PTR)event->hwnd;
+
+    TRACE( "type %d hwnd %p\n", event->type, hwnd );
+
+    switch (event->type)
+    {
+    case HAIKU_EVENT_MOUSE:
+        send_mouse_buttons( hwnd, event );
+        break;
+    case HAIKU_EVENT_WHEEL:
+        send_wheel( hwnd, event->wheel_y, MOUSEEVENTF_WHEEL );
+        send_wheel( hwnd, event->wheel_x, MOUSEEVENTF_HWHEEL );
+        break;
+    case HAIKU_EVENT_KEY_DOWN:
+    case HAIKU_EVENT_KEY_UP:
+        send_key( hwnd, event->key, event->type == HAIKU_EVENT_KEY_DOWN );
+        break;
+    case HAIKU_EVENT_CLOSE:
+        NtUserPostMessage( hwnd, WM_SYSCOMMAND, SC_CLOSE, 0 );
+        break;
+    case HAIKU_EVENT_ACTIVATE:
+        if (event->active) NtUserPostMessage( hwnd, WM_HAIKU_SET_FOREGROUND, 0, 0 );
+        break;
+    case HAIKU_EVENT_SCREEN_CHANGED:
+        NtUserPostMessage( NtUserGetDesktopWindow(), WM_HAIKU_DISPLAY_CHANGED, 0, 0 );
+        break;
+    default:
+        FIXME( "unknown event %d\n", event->type );
+        break;
+    }
+}
+
+static const struct user_driver_funcs haikudrv_funcs =
+{
+    .pCreateWindowSurface = HAIKU_CreateWindowSurface,
+    .pDesktopWindowProc = HAIKU_DesktopWindowProc,
+    .pDestroyWindow = HAIKU_DestroyWindow,
+    .pGetCursorPos = HAIKU_GetCursorPos,
+    .pSetCursorPos = HAIKU_SetCursorPos,
+    .pSetWindowText = HAIKU_SetWindowText,
+    .pUpdateDisplayDevices = HAIKU_UpdateDisplayDevices,
+    .pWindowMessage = HAIKU_WindowMessage,
+    .pWindowPosChanged = HAIKU_WindowPosChanged,
+    .pWindowPosChanging = HAIKU_WindowPosChanging,
+};
+
+static NTSTATUS haikudrv_unix_init( void *arg )
+{
+    if (pipe2( event_pipe, O_CLOEXEC ))
+    {
+        ERR( "failed to create event pipe: %s\n", strerror( errno ));
+        return STATUS_UNSUCCESSFUL;
+    }
+    fcntl( event_pipe[1], F_SETFL, O_NONBLOCK );
+
+    if (haiku_be_init( event_pipe[1] ))
+    {
+        ERR( "failed to initialize the Haiku application\n" );
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    __wine_set_user_driver( &haikudrv_funcs, WINE_GDI_DRIVER_VERSION );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS haikudrv_unix_read_events( void *arg )
+{
+    struct haiku_event event;
+    ssize_t ret;
+
+    for (;;)
+    {
+        ret = read( event_pipe[0], &event, sizeof(event) );
+        if (ret == sizeof(event)) haiku_handle_event( &event );
+        else if (ret < 0 && errno == EINTR) continue;
+        else break;
+    }
+    ERR( "reading Haiku events failed: %s\n", ret < 0 ? strerror( errno ) : "short read" );
+    return STATUS_UNSUCCESSFUL;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    haikudrv_unix_init,
+    haikudrv_unix_read_events,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == haikudrv_unix_func_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    haikudrv_unix_init,
+    haikudrv_unix_read_events,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == haikudrv_unix_func_count );
+
+#endif /* _WIN64 */
diff --git a/dlls/winehaiku.drv/keyboard.c b/dlls/winehaiku.drv/keyboard.c
new file mode 100644
index 0000000..88c6302
--- /dev/null
+++ b/dlls/winehaiku.drv/keyboard.c
@@ -0,0 +1,111 @@
+/*
+ * Haiku driver keyboard support
+ *
+ * Copyright 2026 Techniix
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "haikudrv.h"
+
+/* Haiku key codes (which follow the physical position of the key) to PC
+ * scancodes (set 1). 0x1xx are extended (E0) keys, 0x2xx are E1 keys, as in
+ * the KBDTABLES definitions. The keyboard layout itself is win32u's default. */
+static const WORD haiku_scan_table[0x80] =
+{
+    [0x01] = 0x0001, /* Escape */
+    [0x02] = 0x003b, [0x03] = 0x003c, [0x04] = 0x003d, [0x05] = 0x003e, /* F1 - F4 */
+    [0x06] = 0x003f, [0x07] = 0x0040, [0x08] = 0x0041, [0x09] = 0x0042, /* F5 - F8 */
+    [0x0a] = 0x0043, [0x0b] = 0x0044, [0x0c] = 0x0057, [0x0d] = 0x0058, /* F9 - F12 */
+    [0x0e] = 0x0137, /* Print Screen */
+    [0x0f] = 0x0046, /* Scroll Lock */
+    [0x10] = 0x021d, /* Pause */
+
+    [0x11] = 0x0029, /* ` */
+    [0x12] = 0x0002, [0x13] = 0x0003, [0x14] = 0x0004, [0x15] = 0x0005, /* 1 - 4 */
+    [0x16] = 0x0006, [0x17] = 0x0007, [0x18] = 0x0008, [0x19] = 0x0009, /* 5 - 8 */
+    [0x1a] = 0x000a, [0x1b] = 0x000b, /* 9, 0 */
+    [0x1c] = 0x000c, /* - */
+    [0x1d] = 0x000d, /* = */
+    [0x1e] = 0x000e, /* Backspace */
+    [0x1f] = 0x0152, /* Insert */
+    [0x20] = 0x0147, /* Home */
+    [0x21] = 0x0149, /* Page Up */
+    [0x22] = 0x0045, /* Num Lock */
+    [0x23] = 0x0135, /* Keypad / */
+    [0x24] = 0x0037, /* Keypad * */
+    [0x25] = 0x004a, /* Keypad - */
+
+    [0x26] = 0x000f, /* Tab */
+    [0x27] = 0x0010, [0x28] = 0x0011, [0x29] = 0x0012, [0x2a] = 0x0013, [0x2b] = 0x0014, /* Q W E R T */
+    [0x2c] = 0x0015, [0x2d] = 0x0016, [0x2e] = 0x0017, [0x2f] = 0x0018, [0x30] = 0x0019, /* Y U I O P */
+    [0x31] = 0x001a, /* [ */
+    [0x32] = 0x001b, /* ] */
+    [0x33] = 0x002b, /* \ */
+    [0x34] = 0x0153, /* Delete */
+    [0x35] = 0x014f, /* End */
+    [0x36] = 0x0151, /* Page Down */
+    [0x37] = 0x0047, [0x38] = 0x0048, [0x39] = 0x0049, /* Keypad 7 8 9 */
+    [0x3a] = 0x004e, /* Keypad + */
+
+    [0x3b] = 0x003a, /* Caps Lock */
+    [0x3c] = 0x001e, [0x3d] = 0x001f, [0x3e] = 0x0020, [0x3f] = 0x0021, [0x40] = 0x0022, /* A S D F G */
+    [0x41] = 0x0023, [0x42] = 0x0024, [0x43] = 0x0025, [0x44] = 0x0026, /* H J K L */
+    [0x45] = 0x0027, /* ; */
+    [0x46] = 0x0028, /* ' */
+    [0x47] = 0x001c, /* Enter */
+    [0x48] = 0x004b, [0x49] = 0x004c, [0x4a] = 0x004d, /* Keypad 4 5 6 */
+
+    [0x4b] = 0x002a, /* Left Shift */
+    [0x4c] = 0x002c, [0x4d] = 0x002d, [0x4e] = 0x002e, [0x4f] = 0x002f, /* Z X C V */
+    [0x50] = 0x0030, [0x51] = 0x0031, [0x52] = 0x0032, /* B N M */
+    [0x53] = 0x0033, /* , */
+    [0x54] = 0x0034, /* . */
+    [0x55] = 0x0035, /* / */
+    [0x56] = 0x0036, /* Right Shift */
+    [0x57] = 0x0148, /* Up */
+    [0x58] = 0x004f, [0x59] = 0x0050, [0x5a] = 0x0051, /* Keypad 1 2 3 */
+    [0x5b] = 0x011c, /* Keypad Enter */
+
+    [0x5c] = 0x001d, /* Left Control */
+    [0x5d] = 0x0038, /* Left Command (Alt) */
+    [0x5e] = 0x0039, /* Space */
+    [0x5f] = 0x0138, /* Right Command (AltGr) */
+    [0x60] = 0x011d, /* Right Control */
+    [0x61] = 0x014b, /* Left */
+    [0x62] = 0x0150, /* Down */
+    [0x63] = 0x014d, /* Right */
+    [0x64] = 0x0052, /* Keypad 0 */
+    [0x65] = 0x0053, /* Keypad . */
+    [0x66] = 0x015b, /* Left Option (Windows) */
+    [0x67] = 0x015c, /* Right Option (Windows) */
+    [0x68] = 0x015d, /* Menu */
+    [0x69] = 0x0056, /* ISO extra key (< >) */
+
+    [0x7e] = 0x0054, /* SysRq */
+    [0x7f] = 0x0146, /* Break */
+};
+
+UINT haiku_key_to_scan( int key )
+{
+    if (key < 0 || key >= ARRAY_SIZE(haiku_scan_table)) return 0;
+    return haiku_scan_table[key];
+}
