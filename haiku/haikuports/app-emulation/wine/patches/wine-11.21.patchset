From 7c603053d4b3f4cbc6300488ca9593a3090b1f99 Mon Sep 17 00:00:00 2001
From: Techniix <54037125+Techniix@users.noreply.github.com>
Date: Thu, 5 Nov 2026 22:48:30 -0500
Subject: [PATCH 5/9] ntdll: Keep Haiku-specific code out of other platforms.

Guard the Haiku debugging helpers in the x86_64 signal code with
__HAIKU__, drop an unused Haiku module registration helper, and only
disable recvmsg() control messages and define HAVE_GETADDRINFO on Haiku.

The segfault debug dump is now off by default (WINE_HAIKU_SEGV_DEBUG=1
enables it, =2 also waits for a key press). It used to block on stdin
for every fault.
---
 dlls/ntdll/unix/signal_x86_64.c | 20 +++++++++++++++--
 dlls/ntdll/unix/socket.c        |  3 +--
 dlls/ntdll/unix/virtual.c       | 40 ---------------------------------
 dlls/ws2_32/unixlib.c           |  2 ++
 4 files changed, 21 insertions(+), 44 deletions(-)

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 5a122e7..a878664 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2280,6 +2280,8 @@ static inline BOOL check_invalid_gsbase( struct thread_data *data, ucontext_t *u
     return TRUE;
 }
 
+#ifdef __HAIKU__
+/* Debug helpers for segv_handler, enabled with WINE_HAIKU_SEGV_DEBUG=1 */
 NTSTATUS static LdrFindEntryForAddress2( const void *addr, PLDR_DATA_TABLE_ENTRY *pmod )
 {
     PLIST_ENTRY mark, entry;
@@ -2320,6 +2322,18 @@ static void WriteModuleName(addr_t address)
 	printf("  BaseDllName: %s\n", debugstr_w(pmod->BaseDllName.Buffer)); printf("\n");
 }
 
+static int haiku_segv_debug(void)
+{
+    static int enabled = -1;
+    if (enabled == -1)
+    {
+        const char *env = getenv( "WINE_HAIKU_SEGV_DEBUG" );
+        enabled = env && atoi( env );
+    }
+    return enabled;
+}
+#endif /* __HAIKU__ */
+
 /**********************************************************************
  *		segv_handler
  *
@@ -2333,6 +2347,8 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
     EXCEPTION_RECORD rec = { .ExceptionAddress = (void *)RIP_sig(sigcontext) };
 
 #ifdef __HAIKU__
+    if (haiku_segv_debug())
+    {
 	printf("segv_handler\n");
     printf("&segv_handler: %p\n", &segv_handler);
     printf("pKiUserExceptionDispatcher: %p\n", pKiUserExceptionDispatcher);
@@ -2342,8 +2358,8 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
     printf("  FP: %#" PRIx64 "\n", RBP_sig(sigcontext));
     printf("  address: %#" PRIx64 "\n", siginfo->si_addr);
     WriteModuleName(RIP_sig(sigcontext));
-    fgetc(stdin);
-    //_exit(1);
+    if (haiku_segv_debug() > 1) fgetc(stdin);  /* =2: pause so a debugger can attach */
+    }
 #endif
 
     save_context( data, &context, sigcontext );
diff --git a/dlls/ntdll/unix/socket.c b/dlls/ntdll/unix/socket.c
index a4c42de..17d4efe 100644
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -810,12 +810,11 @@ static NTSTATUS try_recv( int fd, struct async_recv_ioctl *async, ULONG_PTR *siz
     }
     hdr.msg_iov = async->iov;
     hdr.msg_iovlen = async->count;
-#if 0
+#ifndef __HAIKU__  /* Haiku's recvmsg() fails on sockets when ancillary data is requested */
     hdr.msg_control = control_buffer;
     hdr.msg_controllen = sizeof(control_buffer);
 #endif
 
-	TRACE("async->unix_flags: %#x\n", async->unix_flags);
     while ((ret = virtual_locked_recvmsg( fd, &hdr, async->unix_flags )) < 0 && errno == EINTR);
 
     if (ret < 0)
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 1899ca3..e078c2e 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -732,46 +732,6 @@ static void release_builtin_module( void *module )
     free( builtin );
 }
 
-static void haiku_register_module( void *module, int fd, WCHAR *wpath )
-{
-    IMAGE_DOS_HEADER *dos = (IMAGE_DOS_HEADER *)module;
-    IMAGE_NT_HEADERS *nt = (IMAGE_NT_HEADERS *)((char*)module + dos->e_lfanew);
-
-    struct stat stat;
-    fstat(fd, &stat);
-
-    extended_image_info info = {
-        .basic_info = {
-            .type = (true || (nt->FileHeader.Characteristics & IMAGE_FILE_DLL)) ? B_LIBRARY_IMAGE : B_APP_IMAGE,
-            .device = stat.st_dev,
-            .node = stat.st_ino,
-            .text = (uint8*)module + nt->OptionalHeader.BaseOfCode,
-            .data = (uint8*)module + nt->OptionalHeader.BaseOfCode + nt->OptionalHeader.SizeOfCode,
-            .text_size = nt->OptionalHeader.SizeOfCode,
-            .data_size = nt->OptionalHeader.SizeOfImage - nt->OptionalHeader.BaseOfCode,
-        },
-        .text_delta = (int64)module + nt->OptionalHeader.BaseOfCode - (int64)nt->OptionalHeader.ImageBase
-    };
-    ntdll_wcstoumbs(wpath, wcslen(wpath), info.basic_info.name, MAXPATHLEN, FALSE);
-
-    if (true || strstr(info.basic_info.name, ".so") != NULL)
-        return;
-    /*
-     *	static const char builtin_signature[32] = "Wine builtin DLL";
-     *	if (memcmp( dos + 1, builtin_signature, sizeof(builtin_signature) ) == 0)
-     *		return;
-     */
-    for (size_t i = 0; info.basic_info.name[i] != '\0'; i++) {
-        if (info.basic_info.name[i] == '\\')
-            info.basic_info.name[i] = '/';
-    }
-    _kern_register_image(&info, sizeof(info));
-}
-
-static void haiku_unregister_module( void *module )
-{
-}
-
 /***********************************************************************
  *           get_builtin_so_handle
  */
diff --git a/dlls/ws2_32/unixlib.c b/dlls/ws2_32/unixlib.c
index 6dce1e0..8abecb7 100644
--- a/dlls/ws2_32/unixlib.c
+++ b/dlls/ws2_32/unixlib.c
@@ -87,7 +87,9 @@
 # include <linux/irda.h>
 # define HAS_IRDA
 #endif
+#ifdef __HAIKU__
 #define HAVE_GETADDRINFO
+#endif
 
 #include "ntstatus.h"
 #include "windef.h"
-- 
2.43.0


From ddd4b57922b80c5ef2d03e8c13828d3a3723fae3 Mon Sep 17 00:00:00 2001
From: Techniix <54037125+Techniix@users.noreply.github.com>
Date: Thu, 5 Nov 2026 22:48:30 -0500
Subject: [PATCH 6/9] nsiproxy: Report real network adapter info on Haiku

Use SIOCGIFADDR on an AF_LINK socket for the hardware address and
interface type, and SIOCGIFFLAGS/SIOCGIFMTU/SIOCGIFMEDIA/SIOCGIFSTATS
for status, MTU, link state and counters.

Also restore find_entry_from_index(), whose Haiku stub returned NULL so
every table refresh appended duplicate entries.
---
 dlls/nsiproxy.sys/ndis.c | 101 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 88 insertions(+), 13 deletions(-)

diff --git a/dlls/nsiproxy.sys/ndis.c b/dlls/nsiproxy.sys/ndis.c
index 56e476c..d9f59ca 100644
--- a/dlls/nsiproxy.sys/ndis.c
+++ b/dlls/nsiproxy.sys/ndis.c
@@ -63,6 +63,14 @@
 #include <net/if_types.h>
 #endif
 
+#ifdef HAVE_SYS_SOCKIO_H
+#include <sys/sockio.h>
+#endif
+
+#ifdef __HAIKU__
+#include <net/if_media.h>
+#endif
+
 #ifdef HAVE_LINUX_WIRELESS_H
 #include <linux/wireless.h>
 #endif
@@ -107,17 +115,12 @@ static pthread_mutex_t if_list_lock = PTHREAD_MUTEX_INITIALIZER;
 
 static struct if_entry *find_entry_from_index( UINT index )
 {
-#ifdef __HAIKU__
-    return NULL;
-#else
-
     struct if_entry *entry;
 
     LIST_FOR_EACH_ENTRY( entry, &if_list, struct if_entry, entry )
         if (entry->if_index == index) return entry;
 
     return NULL;
-#endif
 }
 
 static struct if_entry *find_entry_from_luid( const NET_LUID *luid )
@@ -130,7 +133,63 @@ static struct if_entry *find_entry_from_luid( const NET_LUID *luid )
     return NULL;
 }
 
-#if defined (SIOCGIFHWADDR) && defined (HAVE_STRUCT_IFREQ_IFR_HWADDR)
+#if defined(__HAIKU__)
+
+static NTSTATUS if_get_physical( const char *name, UINT *type, IF_PHYSICAL_ADDRESS *phys_addr )
+{
+    /* the kernel copies a whole sockaddr_dl (device name + link address) into
+     * ifr_addr, which can be larger than struct ifreq */
+    union
+    {
+        struct ifreq req;
+        char buf[sizeof(struct ifreq) + sizeof(struct sockaddr_storage)];
+    } u;
+    struct sockaddr_dl *sdl = (struct sockaddr_dl *)&u.req.ifr_addr;
+    int fd, size = strlen( name ) + 1;
+    unsigned int i;
+    static const struct type_lookup
+    {
+        u_char sdl_type;
+        IFTYPE mib_type;
+    } types[] =
+    {
+        { IFT_ETHER, MIB_IF_TYPE_ETHERNET },
+        { IFT_PPP, MIB_IF_TYPE_PPP },
+        { IFT_LOOP, MIB_IF_TYPE_LOOPBACK },
+        { IFT_TUNNEL, IF_TYPE_TUNNEL },
+    };
+
+    *type = MIB_IF_TYPE_OTHER;
+    memset( phys_addr, 0, sizeof(*phys_addr) );
+
+    if (size > sizeof(u.req.ifr_name)) return STATUS_NAME_TOO_LONG;
+    memset( &u, 0, sizeof(u) );
+    memcpy( u.req.ifr_name, name, size );
+
+    fd = socket( AF_LINK, SOCK_DGRAM, 0 );
+    if (fd == -1) return STATUS_TOO_MANY_OPENED_FILES;
+
+    if (ioctl( fd, SIOCGIFADDR, &u, sizeof(u) ) || sdl->sdl_family != AF_LINK)
+    {
+        close( fd );
+        return STATUS_SUCCESS;
+    }
+    close( fd );
+
+    for (i = 0; i < ARRAY_SIZE(types); i++)
+        if (sdl->sdl_type == types[i].sdl_type)
+        {
+            *type = types[i].mib_type;
+            break;
+        }
+
+    phys_addr->Length = sdl->sdl_alen;
+    if (phys_addr->Length > sizeof(phys_addr->Address)) phys_addr->Length = 0;
+    memcpy( phys_addr->Address, LLADDR(sdl), phys_addr->Length );
+    return STATUS_SUCCESS;
+}
+
+#elif defined (SIOCGIFHWADDR) && defined (HAVE_STRUCT_IFREQ_IFR_HWADDR)
 static NTSTATUS if_get_physical( const char *name, UINT *type, IF_PHYSICAL_ADDRESS *phys_addr )
 {
     int fd, size, i;
@@ -298,9 +357,7 @@ static struct if_entry *add_entry( UINT index, char *name )
         return NULL;
     }
 
-#ifndef __HAIKU__
     if_get_physical( name, &entry->if_type, &entry->if_phys_addr );
-#endif
 
     entry->if_luid.Info.Reserved = 0;
     entry->if_luid.Info.NetLuidIndex = index;
@@ -356,7 +413,6 @@ static void ifinfo_fill_dynamic( struct if_entry *entry, struct nsi_ndis_ifinfo_
     fd = socket( PF_INET, SOCK_DGRAM, 0 );
     if (fd == -1) return;
 
-#ifndef __HAIKU__
     if (!ioctl( fd, SIOCGIFFLAGS, &req ))
     {
         if (req.ifr_flags & IFF_UP) data->oper_status = IfOperStatusUp;
@@ -365,7 +421,6 @@ static void ifinfo_fill_dynamic( struct if_entry *entry, struct nsi_ndis_ifinfo_
 #endif
         else data->oper_status = IfOperStatusDown;
     } else data->oper_status = IfOperStatusUnknown;
-#endif
 
     data->flags.unk = 0;
     data->flags.not_media_conn = 0;
@@ -384,16 +439,36 @@ static void ifinfo_fill_dynamic( struct if_entry *entry, struct nsi_ndis_ifinfo_
             fclose( fp );
         }
     }
+#elif defined(__HAIKU__)
+    if (!ioctl( fd, SIOCGIFMEDIA, &req ))
+        data->media_conn_state = (req.ifr_media & IFM_ACTIVE) ? MediaConnectStateConnected
+                                                                : MediaConnectStateDisconnected;
+    else
+        data->media_conn_state = MediaConnectStateUnknown;
 #else
     data->media_conn_state = MediaConnectStateConnected;
 #endif
     data->unk = 0;
 
-#ifndef __HAIKU__
     if (!ioctl( fd, SIOCGIFMTU, &req )) data->mtu = req.ifr_mtu;
     else data->mtu = 0;
-#else
-    data->mtu = 0;
+
+#ifdef __HAIKU__
+    if (!ioctl( fd, SIOCGIFSTATS, &req ))
+    {
+        data->in_octets      = req.ifr_stats.receive.bytes;
+        data->in_ucast_pkts  = req.ifr_stats.receive.packets - req.ifr_stats.receive.multicast_packets;
+        data->in_mcast_pkts  = req.ifr_stats.receive.multicast_packets;
+        data->in_errors      = req.ifr_stats.receive.errors;
+        data->in_discards    = req.ifr_stats.receive.dropped;
+        data->out_octets     = req.ifr_stats.send.bytes;
+        data->out_ucast_pkts = req.ifr_stats.send.packets - req.ifr_stats.send.multicast_packets;
+        data->out_mcast_pkts = req.ifr_stats.send.multicast_packets;
+        data->out_errors     = req.ifr_stats.send.errors;
+        data->out_discards   = req.ifr_stats.send.dropped;
+        /* Some applications check for link speed >= 1000000 */
+        data->rcv_speed = data->xmit_speed = 1000000;
+    }
 #endif
 
     close( fd );
-- 
2.43.0


From fbadfb37de0e757af50240e725e8e342eedc81a8 Mon Sep 17 00:00:00 2001
From: Techniix <54037125+Techniix@users.noreply.github.com>
Date: Thu, 5 Nov 2026 22:48:30 -0500
Subject: [PATCH 7/9] ntdll: Fix Haiku build against Wine 11.21

Rename Haiku's spawn_thread() from <OS.h>, which now clashes with
ntdll's own spawn_thread(), and give the Haiku signal context macros
integer selector values. SS_sig was NULL, which made is_16bit() report
16-bit code for every fault whenever %ds was nonzero.
---
 dlls/ntdll/unix/signal_x86_64.c | 7 ++++---
 dlls/ntdll/unix/thread.c        | 2 ++
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index a878664..5c3e35b 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -356,9 +356,9 @@ static inline const WORD *SS_sig_ptr( const ucontext_t *context )
 #define R14_sig(context)     ((context)->uc_mcontext.r14)
 #define R15_sig(context)     ((context)->uc_mcontext.r15)
 #define CS_sig(context)      cs64_sel
-#define FS_sig(context)      NULL
-#define GS_sig(context)      NULL
-#define SS_sig(context)      NULL
+#define FS_sig(context)      0
+#define GS_sig(context)      0
+#define SS_sig(context)      ds64_sel  /* Haiku's mcontext has no segment registers */
 #define EFL_sig(context)     ((context)->uc_mcontext.rflags)
 #define RIP_sig(context)     ((context)->uc_mcontext.rip)
 #define RSP_sig(context)     ((context)->uc_mcontext.rsp)
@@ -2282,6 +2282,7 @@ static inline BOOL check_invalid_gsbase( struct thread_data *data, ucontext_t *u
 
 #ifdef __HAIKU__
 /* Debug helpers for segv_handler, enabled with WINE_HAIKU_SEGV_DEBUG=1 */
+extern int32 find_thread( const char *name );
 NTSTATUS static LdrFindEntryForAddress2( const void *addr, PLDR_DATA_TABLE_ENTRY *pmod )
 {
     PLIST_ENTRY mark, entry;
diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index 4f89deb..85d888d 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -27,9 +27,11 @@
 #ifdef __HAIKU__
 #define cpu_info haiku_cpu_info
 #define exit_thread haiku_exit_thread
+#define spawn_thread haiku_spawn_thread
 #include <OS.h>
 #undef cpu_info
 #undef exit_thread
+#undef spawn_thread
 #endif
 
 #include <assert.h>
-- 
2.43.0


From 27318b85f33a7f4ff393afd1158f62e1c0878d09 Mon Sep 17 00:00:00 2001
From: Techniix <54037125+Techniix@users.noreply.github.com>
Date: Thu, 5 Nov 2026 22:37:21 -0500
Subject: [PATCH 8/9] ntdll: Support WoW64 on Haiku kernels with LDT support

Run 32-bit Windows code the same way as on FreeBSD: use the 32-bit user
code selector from the GDT, allocate %fs selectors for the 32-bit TEB
in the LDT, and switch the %fs base back to the TLS block when entering
unix code. This needs the THREAD_SET_LDT and THREAD_SET_FS_BASE calls
and the fs/fs_base signal context fields from the accompanying Haiku
kernel patch; configure checks for the latter and the 64-bit-only
behaviour is kept on older kernels.

Also take the trap number and error code from the signal context, so
that page faults are told apart from other faults and write faults are
reported as such.
---
 configure.ac                    |   6 ++
 dlls/ntdll/unix/signal_x86_64.c | 124 +++++++++++++++++++++++++++++---
 2 files changed, 122 insertions(+), 8 deletions(-)

diff --git a/configure.ac b/configure.ac
index a90ae73..00b56be 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2178,6 +2178,12 @@ AC_CACHE_CHECK([whether we can use re-entrant gethostbyname_r Linux style],
                 [Define if Linux-style gethostbyname_r and gethostbyaddr_r are available])
    fi
 
+dnl Check for Haiku kernels that report the FS state in the signal context
+dnl (needed for running 32-bit code)
+case $host_os in
+  haiku*) AC_CHECK_MEMBERS([struct fpu_state.fs_base],,,[#include <signal.h>]) ;;
+esac
+
 dnl Check for socket structure members
 AC_CHECK_MEMBERS([struct sockaddr_un.sun_len],,,
 [#include <sys/types.h>
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 5c3e35b..1f90f41 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -83,10 +83,26 @@ extern void _thread_set_tsd_base(uint64_t);
 #else
 #define THREAD_SYSCALLS			"thread"
 #define THREAD_SET_GS_BASE		1
+#define THREAD_SET_FS_BASE		2
+#define THREAD_SET_LDT			3
+
+struct x86_ldt_args
+{
+    uint32_t        start;
+    uint32_t        count;
+    const uint64_t *descriptors;
+};
 
 extern status_t		_kern_generic_syscall(const char *subsystem, uint32 function,
                                               void *buffer, size_t bufferSize);
 #endif
+
+/* Haiku kernels with LDT and custom FS support (needed to run 32-bit code)
+ * report the FS state in the signal context. */
+#ifdef HAVE_STRUCT_FPU_STATE_FS_BASE
+# define HAIKU_WOW64 1
+extern void __wine_haiku_set_fs_base( void *base ) __attribute__((visibility("hidden")));
+#endif
 #endif
 
 #include "ntstatus.h"
@@ -355,15 +371,22 @@ static inline const WORD *SS_sig_ptr( const ucontext_t *context )
 #define R13_sig(context)     ((context)->uc_mcontext.r13)
 #define R14_sig(context)     ((context)->uc_mcontext.r14)
 #define R15_sig(context)     ((context)->uc_mcontext.r15)
+#ifdef HAIKU_WOW64
+#define CS_sig(context)      ((context)->uc_mcontext.fpu.fp_fxsave.cs)
+#define SS_sig(context)      ((context)->uc_mcontext.fpu.fp_fxsave.ss)
+#define FS_sig(context)      ((context)->uc_mcontext.fpu.fp_fxsave.fs)
+#define FSBASE_sig(context)  ((context)->uc_mcontext.fpu.fp_fxsave.fs_base)
+#else
 #define CS_sig(context)      cs64_sel
 #define FS_sig(context)      0
+#define SS_sig(context)      ds64_sel  /* older Haiku kernels don't report segment registers */
+#endif
 #define GS_sig(context)      0
-#define SS_sig(context)      ds64_sel  /* Haiku's mcontext has no segment registers */
 #define EFL_sig(context)     ((context)->uc_mcontext.rflags)
 #define RIP_sig(context)     ((context)->uc_mcontext.rip)
 #define RSP_sig(context)     ((context)->uc_mcontext.rsp)
-#define TRAP_sig(context)    TRAP_x86_PAGEFLT
-#define ERROR_sig(context)   0
+#define TRAP_sig(context)    ((context)->uc_mcontext.fpu.fp_fxsave.trap_number)
+#define ERROR_sig(context)   ((context)->uc_mcontext.fpu.fp_fxsave.error_code)
 #define FPU_sig(context)     ((XMM_SAVE_AREA32 *)&(context)->uc_mcontext.fpu)
 #define XState_sig(context)  NULL
 
@@ -758,9 +781,11 @@ static inline void set_sigcontext( const CONTEXT *context, ucontext_t *sigcontex
     R14_sig(sigcontext) = context->R14;
     R15_sig(sigcontext) = context->R15;
     RIP_sig(sigcontext) = context->Rip;
-#ifndef __HAIKU__
+#if !defined(__HAIKU__) || defined(HAIKU_WOW64)
     CS_sig(sigcontext)  = context->SegCs;
     FS_sig(sigcontext)  = context->SegFs;
+#endif
+#ifndef __HAIKU__
     EFL_sig(sigcontext) = context->EFlags;
 #endif
 }
@@ -831,6 +856,18 @@ static inline void leave_handler( struct thread_data *data, ucontext_t *sigconte
     if (!is_inside_signal_stack( data, (void *)RSP_sig(sigcontext )) &&
         !is_inside_syscall( data, RSP_sig(sigcontext )))
         _thread_set_tsd_base( (uint64_t)data->teb );
+#elif defined(HAIKU_WOW64)
+    /* the kernel restores %fs and its base from the signal context */
+    if (amd64_data->pthread_teb)
+    {
+        if (!is_inside_signal_stack( data, (void *)RSP_sig(sigcontext )) &&
+            !is_inside_syscall( data, RSP_sig(sigcontext) ))
+        {
+            FS_sig(sigcontext) = amd64_data->fs;
+            FSBASE_sig(sigcontext) = (ULONG_PTR)get_wow_teb( data->teb );
+        }
+        else FSBASE_sig(sigcontext) = (ULONG_PTR)amd64_data->pthread_teb;
+    }
 #endif
     if (is_16bit( sigcontext )) return;
 #ifdef DS_sig
@@ -1684,7 +1721,7 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
                    "1:\tmovq %rdi,%rsp\n\t"    /* user_rsp */
                    "movq 0x98(%r14),%rbp\n\t"  /* prev_frame->rbp */
                    "ldmxcsr 0xd8(%r14)\n\t"    /* prev_frame->xsave.MxCsr */
-#if defined(__linux__) || defined(__FreeBSD__)
+#if defined(__linux__) || defined(__FreeBSD__) || defined(HAIKU_WOW64)
                    "movb $1,0x340(%r13)\n\t"   /* amd64_thread_data()->syscall_dispatch */
                    "movw 0x338(%r13),%ax\n"    /* amd64_thread_data()->fs */
                    "testw %ax,%ax\n\t"
@@ -2748,6 +2785,22 @@ static void sigsys_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
 #endif
 
 
+#ifdef HAIKU_WOW64
+const char __wine_haiku_thread_syscalls[] __attribute__((visibility("hidden"))) = THREAD_SYSCALLS;
+/* Called from the syscall dispatchers; must not touch TLS, as %fs may still
+ * point to the 32-bit TEB. Expects a 16-byte aligned stack. */
+__ASM_GLOBAL_FUNC( __wine_haiku_set_fs_base,
+                   "pushq %rdi\n\t"               /* buffer: base */
+                   "movq %rsp,%rdx\n\t"
+                   "leaq __wine_haiku_thread_syscalls(%rip),%rdi\n\t"
+                   "movl $2,%esi\n\t"             /* THREAD_SET_FS_BASE */
+                   "movl $8,%ecx\n\t"
+                   "call _kern_generic_syscall@PLT\n\t"
+                   "popq %rdi\n\t"
+                   "ret" )
+#endif
+
+
 /***********************************************************************
  *           ldt_set_entry
  */
@@ -2778,6 +2831,15 @@ void ldt_set_entry( WORD sel, LDT_ENTRY entry )
         perror("i386_set_ldt");
         exit(1);
     }
+#elif defined(HAIKU_WOW64)
+    struct x86_ldt_args args = { .start = sel >> 3, .count = 1, .descriptors = (const uint64_t *)&entry };
+    status_t ret = _kern_generic_syscall( THREAD_SYSCALLS, THREAD_SET_LDT, &args, sizeof(args) );
+    if (ret)
+    {
+        fprintf( stderr, "wine: setting LDT entries failed (%s); running 32-bit code needs "
+                 "a Haiku kernel with LDT support\n", strerror( ret ));
+        exit(1);
+    }
 #else
     fprintf( stderr, "No LDT support on this platform\n" );
     exit(1);
@@ -2922,6 +2984,8 @@ void signal_init_process( TEB *teb )
         cs32_sel = ldt_alloc_entry( ldt_make_cs32_entry() );
 #elif defined(__FreeBSD__)
         cs32_sel = GSEL(GUCODE32_SEL, SEL_UPL);
+#elif defined(HAIKU_WOW64)
+        cs32_sel = 0x1b;  /* USER32_CODE_SELECTOR */
 #endif
     }
 
@@ -3011,8 +3075,11 @@ void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, TEB *teb )
 #elif defined (__APPLE__)
     thread_data->pthread_teb = mac_thread_gsbase();
 #elif defined (__HAIKU__)
-    //thread_data->pthread_teb = amd64_thread_data()->pthread_teb;
     _kern_generic_syscall(THREAD_SYSCALLS, THREAD_SET_GS_BASE, &teb, sizeof(teb));
+#ifdef HAIKU_WOW64
+    /* the first TLS slot holds the TLS base, which %fs must point to in unix code */
+    if (get_wow_teb( teb )) __asm__ volatile( "movq %%fs:0,%0" : "=r" (thread_data->pthread_teb) );
+#endif
 #else
 # error Please define setting %gs for your architecture
 #endif
@@ -3245,6 +3312,27 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "popq %r8\n\t"
                    "leaq -0x98(%rbp),%rcx\n"
                    "2:\n\t"
+#elif defined(HAIKU_WOW64)
+                   "movq 0x320(%r13),%rsi\n\t"     /* amd64_thread_data()->pthread_teb */
+                   "testq %rsi,%rsi\n\t"
+                   "jz 2f\n\t"
+                   "pushq %rdx\n\t"
+                   "pushq %r8\n\t"
+                   "pushq %r9\n\t"
+                   "pushq %r10\n\t"
+                   "movq %rsp,%rax\n\t"
+                   "andq $~15,%rsp\n\t"
+                   "pushq %rax\n\t"
+                   "pushq %rax\n\t"
+                   "movq %rsi,%rdi\n\t"
+                   "call " __ASM_NAME("__wine_haiku_set_fs_base") "\n\t"
+                   "movq (%rsp),%rsp\n\t"
+                   "popq %r10\n\t"
+                   "popq %r9\n\t"
+                   "popq %r8\n\t"
+                   "popq %rdx\n\t"
+                   "leaq -0x98(%rbp),%rcx\n"
+                   "2:\n\t"
 #elif defined __APPLE__
                    "movq 0x320(%r13),%rdi\n\t"     /* amd64_thread_data()->pthread_teb */
                    "xorl %esi,%esi\n\t"
@@ -3291,7 +3379,7 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    __ASM_CFI(".cfi_remember_state\n\t")
                    __ASM_CFI_CFA_IS_AT2(rcx, 0xa8, 0x01) /* frame->syscall_cfa */
                    "leaq 0x70(%rcx),%rsp\n\t"      /* %rsp > frame means no longer inside syscall */
-#if defined(__linux__) || defined(__FreeBSD__)
+#if defined(__linux__) || defined(__FreeBSD__) || defined(HAIKU_WOW64)
                    "movb $1,0x340(%r13)\n\t"       /* amd64_thread_data()->syscall_dispatch */
                    "movw 0x338(%r13),%dx\n"        /* amd64_thread_data()->fs */
                    "testw %dx,%dx\n\t"
@@ -3561,6 +3649,26 @@ __ASM_GLOBAL_FUNC( __wine_unix_call_dispatcher,
                    "popq %r9\n\t"
                    "popq %r8\n\t"
                    "2:\n\t"
+#elif defined(HAIKU_WOW64)
+                   "movq 0x320(%r13),%rsi\n\t"     /* amd64_thread_data()->pthread_teb */
+                   "testq %rsi,%rsi\n\t"
+                   "jz 2f\n\t"
+                   "pushq %rdx\n\t"
+                   "pushq %r8\n\t"
+                   "pushq %r9\n\t"
+                   "pushq %r10\n\t"
+                   "movq %rsp,%rax\n\t"
+                   "andq $~15,%rsp\n\t"
+                   "pushq %rax\n\t"
+                   "pushq %rax\n\t"
+                   "movq %rsi,%rdi\n\t"
+                   "call " __ASM_NAME("__wine_haiku_set_fs_base") "\n\t"
+                   "movq (%rsp),%rsp\n\t"
+                   "popq %r10\n\t"
+                   "popq %r9\n\t"
+                   "popq %r8\n\t"
+                   "popq %rdx\n\t"
+                   "2:\n\t"
 #elif defined __APPLE__
                    "movq 0x320(%r13),%rdi\n\t"     /* amd64_thread_data()->pthread_teb */
                    "xorl %esi,%esi\n\t"
@@ -3587,7 +3695,7 @@ __ASM_GLOBAL_FUNC( __wine_unix_call_dispatcher,
                    /* switch to user stack */
                    "movq 0x88(%rcx),%rsp\n\t"
                    __ASM_CFI(".cfi_restore_state\n\t")
-#if defined(__linux__) || defined(__FreeBSD__)
+#if defined(__linux__) || defined(__FreeBSD__) || defined(HAIKU_WOW64)
                    "movb $1,0x340(%r13)\n\t"       /* amd64_thread_data()->syscall_dispatch */
                    "movw 0x338(%r13),%dx\n"        /* amd64_thread_data()->fs */
                    "testw %dx,%dx\n\t"
-- 
2.43.0


From d6e3de5c6e68d918f57e3ff1e1e7570007a4844e Mon Sep 17 00:00:00 2001
From: Techniix <54037125+Techniix@users.noreply.github.com>
Date: Thu, 5 Nov 2026 22:47:38 -0500
Subject: [PATCH 9/9] winehaiku.drv: Add a native Haiku display driver

Top-level windows get a borderless BWindow each, with Wine drawing the
non-client area as usual. Window surfaces are copied into a BBitmap
that the window's view draws. The Haiku window threads only queue
mouse, wheel, keyboard, close and activation events into a pipe, which
a dedicated Wine thread reads and passes to win32u, so no Haiku thread
ever calls into Wine. Keys are sent as scancodes and translated by
win32u's default keyboard layout.

The main screen is reported as the only monitor with its current mode.
Not implemented yet: cursors, clipboard, OpenGL/Vulkan, layered window
transparency, display mode changes and multiple monitors.

Based on the Wine 7.1 Haiku driver by X512, rewritten for the current
win32u driver interface. It is tried before the Wayland driver.
---
 configure.ac                       |   7 +-
 dlls/winehaiku.drv/Makefile.in     |  14 ++
 dlls/winehaiku.drv/display.c       |  66 +++++
 dlls/winehaiku.drv/dllmain.c       |  52 ++++
 dlls/winehaiku.drv/haiku_be.cpp    | 382 +++++++++++++++++++++++++++++
 dlls/winehaiku.drv/haiku_be.h      |  84 +++++++
 dlls/winehaiku.drv/haikudrv.h      |  78 ++++++
 dlls/winehaiku.drv/haikudrv_main.c | 188 ++++++++++++++
 dlls/winehaiku.drv/keyboard.c      | 111 +++++++++
 dlls/winehaiku.drv/unixlib.h       |  33 +++
 dlls/winehaiku.drv/window.c        | 317 ++++++++++++++++++++++++
 programs/explorer/desktop.c        |   2 +-
 12 files changed, 1332 insertions(+), 2 deletions(-)
 create mode 100644 dlls/winehaiku.drv/Makefile.in
 create mode 100644 dlls/winehaiku.drv/display.c
 create mode 100644 dlls/winehaiku.drv/dllmain.c
 create mode 100644 dlls/winehaiku.drv/haiku_be.cpp
